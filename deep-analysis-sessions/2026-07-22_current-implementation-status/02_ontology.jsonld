  "@graph": [
    {
      "@id": "ea:session/current-implementation-status/topic/T001",
      "@type": "Topic",
      "title": "The audited state is a multi-repository pre-v1 worktree",
      "content": "Rupa and RupaKit are on root main, Swift-CAD is a separate dirty repository one commit ahead of origin/main, and swift-OpenUSD is clean at its pinned revision.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "investigations": [{"title":"Git state inspection","status":"Completed","findings":"Root and nested repository states were inspected without modification.","completedAt":"2026-07-22T09:53:07+09:00"}]
    },
    {
      "@id": "ea:session/current-implementation-status/topic/T002",
      "@type": "Topic",
      "title": "Universal 3D foundation has substantial first-slice implementation",
      "content": "Stable values, universal capabilities, mesh source/editing/attributes, project source, evaluation providers, CAD projection, viewport snapshot, and project transactions have concrete implementations and focused tests in source.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.92,
      "decompositionStrategy": "structural",
      "investigations": [{"title":"Source path inspection","status":"Completed","findings":"Public methods include validation, typed errors, and mutation/evaluation logic rather than placeholders.","completedAt":"2026-07-22T09:53:07+09:00"}]
    },
    {
      "@id": "ea:session/current-implementation-status/topic/T003",
      "@type": "Topic",
      "title": "Universal 3D is not yet the active application path",
      "content": "The app and rendering layer still build CAD-specific ViewportScene values; the universal viewport snapshot has no production renderer or input consumer, and mesh selection remains untracked and unwired.",
      "epistemicStatus": "Verified",
      "confidence": 0.98,
      "manifestsAs": "ea:session/current-implementation-status/topic/T008"
    },
    {
      "@id": "ea:session/current-implementation-status/topic/T004",
      "@type": "Topic",
      "title": "Swift-CAD completion remains 0 of 8 gates",
      "content": "The normative roadmap records 55 provisional capabilities, 23 supported, 32 partial, 52 development envelopes, zero final evidence manifests, and all eight completion gates open.",
      "epistemicStatus": "Verified",
      "confidence": 0.99
    },
    {
      "@id": "ea:session/current-implementation-status/topic/T005",
      "@type": "Topic",
      "title": "Current executable verification is red",
      "content": "Rupa does not build against the current Swift-CAD worktree; CADGeometry has 18 failing tests and CADKernel has 48 failing tests in complete target runs.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "causes": "ea:session/current-implementation-status/topic/T006"
    },
    {
      "@id": "ea:session/current-implementation-status/topic/T006",
      "@type": "Topic",
      "title": "No release or conformance claim is supportable from this worktree",
      "content": "The build failure, failing lower-level suites, dirty repositories, absent final evidence manifests, and incomplete application integration block release readiness.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "addressedBy": "ea:session/current-implementation-status/topic/T007"
    },
    {
      "@id": "ea:session/current-implementation-status/topic/T007",
      "@type": "Topic",
      "title": "Restore the vertical integration gate before adding breadth",
      "content": "First reconcile Swift-CAD API changes with RupaKit, then fix geometry/kernel regressions, integrate the universal viewport and mixed CAD/mesh persistence path, and finally rerun same-revision app and package evidence.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.95,
      "addresses": "ea:session/current-implementation-status/topic/T006",
      "produces": "ea:session/current-implementation-status/topic/T008"
    },
