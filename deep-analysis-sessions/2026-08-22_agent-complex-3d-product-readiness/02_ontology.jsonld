    {
      "@id": "insight:reproducibility-root",
      "@type": "Insight",
      "title": "Dependency-baseline drift is a root blocker",
      "content": "The missing import is the immediate compile defect, while the architectural root is that an uncommitted local kernel state participates in the product build without a passing compatibility tuple.",
      "epistemicStatus": "Verified",
      "confidence": 0.98,
      "derivedFrom": ["evidence:build-failure", "evidence:dirty-dependency"],
      "rationale": "A one-line import can restore compilation but cannot make the evaluated dependency state reproducible or release-verifiable.",
      "supportsClaim": ["insight:broad-incomplete", "insight:readiness-verdict"]
    },
    {
      "@id": "insight:critical-path",
      "@type": "Insight",
      "title": "Completion should proceed by vertical conformance",
      "content": "Restore a clean baseline, unify project authority, conform Core Precision CAD, conform Agent Variant with observation and export, then add specialized domains.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.94,
      "derivedFrom": ["evidence:goal-contract", "evidence:kernel-gates", "evidence:dual-authority", "evidence:build-failure"],
      "rationale": "Every downstream profile depends on Core, and additional isolated operations do not close workflow gates.",
      "addresses": "insight:broad-incomplete"
    },
