  "@graph": [
    {
      "@id": "ea:session/swift-cad-status/topic/T001",
      "@type": "Topic",
      "title": "Uncompromising completion condition",
      "content": "Completion requires 55 of 55 general capabilities supported, zero partial or planned capabilities, no valid public input rejected because of an implementation shape envelope, exact analytic or rational NURBS results with validated B-rep and deterministic lineage, no exact mesh fallback, and G0 through G7 passing on one tested clean revision.",
      "epistemicStatus": "Verified",
      "confidence": 0.98,
      "visualEvidenceRequirement": {"evidencePattern": "gap", "requiredChartType": "capability and gate completion matrix"},
      "investigations": []
    },
    {
      "@id": "ea:session/swift-cad-status/topic/T002",
      "@type": "Topic",
      "title": "Capability catalog remains predominantly partial",
      "content": "The compiled catalog contains 55 capability IDs. Four are supported and 51 are partial.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "decompositionStrategy": "structural",
      "investigations": []
    },
    {
      "@id": "ea:session/swift-cad-status/topic/T003",
      "@type": "Topic",
      "title": "No final gate is passed",
      "content": "ROADMAP and the goal-contract checker report zero of eight gates passed, and no final evidence manifest is recorded.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "investigations": []
    },
    {
      "@id": "ea:session/swift-cad-status/topic/T004",
      "@type": "Topic",
      "title": "G1 exact geometry is incomplete",
      "content": "Analytic and rational evaluation foundations exist, but projections, the complete curve/surface and surface/surface intersection matrix, higher-order singular cases, property coverage, and external oracle evidence are incomplete.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.95,
      "causes": "ea:session/swift-cad-status/topic/T005",
      "investigations": []
    },
    {
      "@id": "ea:session/swift-cad-status/topic/T005",
      "@type": "Topic",
      "title": "G2 validated topology is incomplete",
      "content": "Coedge B-rep, pcurves, validation scopes, sewing, explicit repair, and lineage exist, but general analytic/NURBS shell invariants, volume, healing, split/merge behavior, and oracle comparison are not closed.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.94,
      "causes": "ea:session/swift-cad-status/topic/T006",
      "investigations": []
    },
    {
      "@id": "ea:session/swift-cad-status/topic/T006",
      "@type": "Topic",
      "title": "G3 exact modeling is shape-envelope limited",
      "content": "Named feature evaluators and exact fixtures exist, but Boolean, Sweep, Loft, blends, shell, direct edits, patterns, and curve/surface editing remain partial and reject valid public inputs outside implemented shape envelopes.",
      "epistemicStatus": "Verified",
      "confidence": 0.97,
      "causes": "ea:session/swift-cad-status/topic/T007",
      "investigations": []
    },
    {
      "@id": "ea:session/swift-cad-status/topic/T007",
      "@type": "Topic",
      "title": "G4 public path proof is incomplete",
      "content": "CADCommand, DocumentEditor, KernelQuery, and EvaluatedDocument exist and CADAgentCommand is absent, but repository-wide bypass inventory, arbitrary edit-chain parity, stable selection, and deterministic cache proof are missing.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.92,
      "investigations": []
    },
    {
      "@id": "ea:session/swift-cad-status/topic/T008",
      "@type": "Topic",
      "title": "G5 constraint proof is incomplete",
      "content": "The IR names the requested relation set and the kernel contains DOF/residual/Jacobian and Levenberg-Marquardt foundations, but complete relation, Jacobian oracle, diagnostic, singular, and document-edit integration evidence is absent.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.92,
      "investigations": []
    },
    {
      "@id": "ea:session/swift-cad-status/topic/T009",
      "@type": "Topic",
      "title": "G6 exact exchange is incomplete",
      "content": "STEP and IGES exact subsets and import budgets exist, but general supported geometry/topology coverage, external corpora, resource fuzzing, and third-party CAD oracle validation are absent.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.94,
      "investigations": []
    },
    {
      "@id": "ea:session/swift-cad-status/topic/T010",
      "@type": "Topic",
      "title": "G7 release verification is absent",
      "content": "No one-revision evidence set covers complete integration, property tests, parser fuzzing, external oracles, large models, allocations, incremental evaluation, and all-platform runtime.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "investigations": []
    },
    {
      "@id": "ea:session/swift-cad-status/topic/T011",
      "@type": "Topic",
      "title": "Dependency-ordered closure sequence",
      "content": "Close the reproducible contract, then exact geometry, validated topology, general exact modeling, shared public paths, constraints, exact exchange, and finally one-revision release verification.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.91,
      "decompositionStrategy": "causal and temporal",
      "addresses": "ea:session/swift-cad-status/topic/T003",
