      "@id": "ea:session/2026-07-19_swift-cad-goal-audit/topic/T001",
      "@type": "Topic",
      "title": "All completion gates are open",
      "content": "ROADMAP records G0 through G7 as OPEN and no final evidence manifests exist.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "visualEvidenceRequirement": { "evidencePattern": "gap", "requiredChartType": "gate bar" }
    },
    {
      "@id": "ea:session/2026-07-19_swift-cad-goal-audit/topic/T002",
      "@type": "Topic",
      "title": "Only four provisional capabilities are fully supported",
      "content": "The compiled catalog declares 55 capabilities: 4 supported and 51 partial.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "decompositionStrategy": "structural",
      "visualEvidenceRequirement": { "evidencePattern": "composition", "requiredChartType": "stacked bars" }
    },
    {
      "@id": "ea:session/2026-07-19_swift-cad-goal-audit/topic/T003",
      "@type": "Topic",
      "title": "Exact intersection truth lacks an implicit curve type",
      "content": "Curve3D contains line, circle, analytic, and B-spline cases only. A general rational-surface intersection need not be rationally parameterizable, so a fitted B-spline cannot be the uncompromising exact source of truth by itself.",
      "epistemicStatus": "Verified",
      "confidence": 0.98,
      "causes": "ea:session/2026-07-19_swift-cad-goal-audit/topic/T006"
    },
    {
      "@id": "ea:session/2026-07-19_swift-cad-goal-audit/topic/T004",
      "@type": "Topic",
      "title": "The current implementation revision is not attestable",
      "content": "HEAD is ahead of origin, the worktree is dirty with modified and untracked implementation paths, and there is no same-revision Evidence directory.",
      "epistemicStatus": "Verified",
      "confidence": 0.99
    },
    {
      "@id": "ea:session/2026-07-19_swift-cad-goal-audit/topic/T006",
      "@type": "Topic",
      "title": "Topology, modeling, API, constraints, and exact exchange remain incomplete",
      "content": "No topology, modeling, shared API, or exchange capability currently has supported status. Each contains bounded working envelopes but no full-domain completion proof.",
      "epistemicStatus": "Verified",
      "confidence": 0.99
    },
    {
      "@id": "ea:session/2026-07-19_swift-cad-goal-audit/topic/T007",
      "@type": "Topic",
      "title": "The capability inventory is not closed",
      "content": "Public native persistence and non-USD mesh exchange are present in the public surface but do not have primary capability rows. Therefore 55 is a provisional count, not a safe final denominator.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.94
    },
    {
      "@id": "ea:session/2026-07-19_swift-cad-goal-audit/topic/T008",
      "@type": "Topic",
      "title": "Completion must be inventory-derived and representation-complete",
      "content": "The goal contract must require 100% public-contract registration, N/N supported capabilities, certified implicit exact geometry, eight same-revision gate manifests, and a clean worktree.",
      "epistemicStatus": "Verified",
      "confidence": 0.98,
      "addresses": "ea:session/2026-07-19_swift-cad-goal-audit/topic/T007"
    },
    {
      "@id": "ea:session/2026-07-19_swift-cad-goal-audit/topic/T100",
      "@type": "Topic",
      "title": "Uncompromising completion contract",
      "content": "Complete means 100% public contracts registered, every resulting capability supported, G0 through G7 passed on one revision, no mesh fallback, and no valid input rejected for an implementation envelope.",
      "epistemicStatus": "Verified",
      "confidence": 0.98,
      "visualEvidenceRequirement": { "evidencePattern": "causal", "requiredChartType": "dependency flow" }
    },
