    {
      "@id": "ea:session/2026-07-19_swift-cad-goal-audit/insight/I002",
      "@type": "Insight",
      "title": "A frozen 55-capability denominator is a false-completion loophole",
      "content": "The catalog count must grow when the public-contract inventory discovers an omitted operation; otherwise unregistered behavior can disappear from the denominator.",
      "epistemicStatus": "Verified",
      "confidence": 0.97,
      "derivedFrom": [
        "ea:session/2026-07-19_swift-cad-goal-audit/topic/T002",
        "ea:session/2026-07-19_swift-cad-goal-audit/topic/T007"
      ],
      "rationale": "One-to-one capability accounting is only exhaustive when the source-side public inventory is independently generated.",
      "supportsClaim": ["ea:session/2026-07-19_swift-cad-goal-audit/topic/T100"],
      "primaryEvidence": ["ea:session/2026-07-19_swift-cad-goal-audit/evidence/E002"],
