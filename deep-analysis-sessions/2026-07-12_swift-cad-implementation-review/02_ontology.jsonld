  "@graph": [
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T001",
      "@type": "Topic",
      "title": "Functional sufficiency verdict",
      "content": "swift-CAD is substantial for a narrow declared modeling subset, but it is not a releasable standalone SDK and is not sufficient for the broader Rupa/Plasticity-class goal.",
      "epistemicStatus": "Verified",
      "confidence": 0.94,
      "visualEvidenceRequirement": {
        "evidencePattern": "gap",
        "requiredChartType": "capability readiness matrix"
      }
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T002",
      "@type": "Topic",
      "title": "Requirement validity verdict",
      "content": "The architectural principles are sound, but the current documents do not form one authoritative, internally consistent, traceable release contract.",
      "epistemicStatus": "Verified",
      "confidence": 0.94,
      "visualEvidenceRequirement": {
        "evidencePattern": "comparison",
        "requiredChartType": "requirement authority matrix"
      }
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T003",
      "@type": "Topic",
      "title": "Underestimated and unimplemented goals",
      "content": "The goal has been underestimated primarily in depth: capabilities are named and partially implemented without complete robustness, parity, compatibility, performance, and conformance gates.",
      "epistemicStatus": "Verified",
      "confidence": 0.97,
      "visualEvidenceRequirement": {
        "evidencePattern": "gap",
        "requiredChartType": "risk and capability gap matrix"
      }
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T004",
      "@type": "Topic",
      "title": "Two distinct product boundaries",
      "content": "The repository contains a narrow official rectangle/extrude exchange scope and a separate strategic Rupa/Plasticity-class kernel roadmap.",
      "epistemicStatus": "Verified",
      "confidence": 0.97
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T005",
      "@type": "Topic",
      "title": "Standalone distribution is blocked",
      "content": "A clean checkout cannot resolve the local sibling swift-OpenUSD dependency, contradicting the documented remote Swift Package installation.",
      "epistemicStatus": "Verified",
      "confidence": 0.99
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T006",
      "@type": "Topic",
      "title": "CI is not truth-bearing",
      "content": "The current CI fails before testing, and its forbidden-pattern grep contains deterministic false-positive and real-failure matches.",
      "epistemicStatus": "Verified",
      "confidence": 0.99
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T007",
      "@type": "Topic",
      "title": "Minimal kernel foundation is substantive",
      "content": "Typed IR, unit and tolerance validation, analytic/NURBS geometry, deterministic evaluation, B-rep validation, tessellation, and strict exchange subsets are materially implemented.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.86
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T008",
      "@type": "Topic",
      "title": "Public operation parity is incomplete",
      "content": "FeatureOperation, DocumentBuilder, and CADAgentCommand expose different operation sets despite the shared UI/Agent parity requirement.",
      "epistemicStatus": "Verified",
      "confidence": 0.99
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T009",
      "@type": "Topic",
      "title": "Native schema evolution is incomplete",
      "content": "Persisted source fields and operation variants have expanded while SchemaVersion.current remains 1.0.0 and no explicit migration layer or historical fixture set exists.",
      "epistemicStatus": "Verified",
      "confidence": 0.97
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T010",
      "@type": "Topic",
      "title": "Advanced modeling capabilities are incomplete",
      "content": "General booleans, full sketch constraints, direct editing, advanced surfaces, and stable naming are limited to explicit subsets; fillet, chamfer, shell, patch, and thicken are absent.",
      "epistemicStatus": "Verified",
      "confidence": 0.98
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T011",
      "@type": "Topic",
      "title": "Exact CAD exchange goal is incomplete",
      "content": "STEP and IGES currently exchange tessellated meshes or triangle wires rather than editable curves, surfaces, trims, topology, and design intent.",
      "epistemicStatus": "Verified",
      "confidence": 0.99
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T012",
      "@type": "Topic",
      "title": "Performance and memory goal is unverified",
      "content": "Incremental reuse exists, but the required allocation/timing budgets, benchmark target, and borrowed/COW dense data contracts are absent.",
      "epistemicStatus": "Verified",
      "confidence": 0.98
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T013",
      "@type": "Topic",
      "title": "Zero-copy boundary is only partial",
      "content": "ByteSource and ByteSink establish explicit transport ownership, while several text importers still materialize whole-file String values.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.9
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T014",
      "@type": "Topic",
      "title": "Test inventory is large but incomplete as product evidence",
      "content": "The repository has 618 tests and strong negative validation, but current full-suite evidence, platform/trait coverage, conformance corpora, and performance evidence are missing.",
      "epistemicStatus": "Verified",
      "confidence": 0.95
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T015",
      "@type": "Topic",
      "title": "Requirement traceability is absent",
      "content": "The documents contain many normative statements but no stable requirement IDs or automated mapping to APIs, supported geometry subsets, tests, and release gates.",
      "epistemicStatus": "Verified",
      "confidence": 0.98
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T016",
      "@type": "Topic",
      "title": "Robust B-rep enabling platform is under-scoped",
      "content": "The roadmap names general booleans, blends, shells, and patches without separately defining the intersection, trimming, sewing/healing, topology mutation, and tolerance-escalation capabilities they depend on.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.86
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T017",
      "@type": "Topic",
      "title": "Specification schema is stale",
      "content": "selectionDimensions is persisted and validated in code but absent from the normative CADDocument and document.json field tables.",
      "epistemicStatus": "Verified",
      "confidence": 0.99
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T018",
      "@type": "Topic",
      "title": "Pattern and technical drawing workstreams are absent",
      "content": "Pattern/array evaluation and deterministic hidden-line, section, hatching, and view-metadata output have requirements but no corresponding feature implementation.",
      "epistemicStatus": "Verified",
      "confidence": 0.99
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T019",
      "@type": "Topic",
      "title": "Restore a truth-bearing build",
      "content": "Make a fresh clone resolve all dependencies, make macOS and WASM CI green, and replace brittle text grep with reliable source-rule checks.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.92,
      "addresses": [
        "ea:session/swift-cad-implementation-review/topic/T005",
        "ea:session/swift-cad-implementation-review/topic/T006"
      ]
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T020",
      "@type": "Topic",
      "title": "Establish a normative capability ledger",
      "content": "Separate current support from roadmap and give every capability a stable ID, supported geometry matrix, typed failure codes, parity state, and evidence links.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.91,
      "addresses": [
        "ea:session/swift-cad-implementation-review/topic/T002",
        "ea:session/swift-cad-implementation-review/topic/T008",
        "ea:session/swift-cad-implementation-review/topic/T015",
        "ea:session/swift-cad-implementation-review/topic/T017"
      ]
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/topic/T021",
      "@type": "Topic",
      "title": "Complete vertical slices before adding breadth",
      "content": "For each prioritized modeling capability, finish geometry, topology, persistent naming, facade and agent parity, persistence, conformance, and performance gates together.",
      "epistemicStatus": "Evidenced",
      "confidence": 0.9,
      "addresses": [
        "ea:session/swift-cad-implementation-review/topic/T003",
        "ea:session/swift-cad-implementation-review/topic/T009",
        "ea:session/swift-cad-implementation-review/topic/T010",
        "ea:session/swift-cad-implementation-review/topic/T011",
        "ea:session/swift-cad-implementation-review/topic/T012",
        "ea:session/swift-cad-implementation-review/topic/T016",
        "ea:session/swift-cad-implementation-review/topic/T018"
      ]
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/evidence/E001",
      "@type": "Evidence",
      "title": "Documents define conflicting support scopes",
      "content": "SPEC declares a narrow official sketch/extrude pipeline while later SPEC sections and CAD_KERNEL_REQUIREMENTS describe much broader implemented and strategic surfaces.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "source": "SPEC.md and CAD_KERNEL_REQUIREMENTS.md",
      "sourceUrl": "file:///Users/1amageek/Desktop/3D/swift-CAD/SPEC.md",
      "reliability": 0.99,
      "supports": [
        "ea:session/swift-cad-implementation-review/topic/T002",
        "ea:session/swift-cad-implementation-review/topic/T004",
        "ea:session/swift-cad-implementation-review/topic/T015"
      ],
      "chartableData": []
    },
    {
      "@id": "ea:session/swift-cad-implementation-review/evidence/E002",
      "@type": "Evidence",
      "title": "Fresh package resolution fails",
      "content": "An isolated git archive followed by swift package resolve fails because /private/tmp/swift-OpenUSD does not exist.",
